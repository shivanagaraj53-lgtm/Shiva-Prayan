<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive icon, used from Android 8.0 onward. The launcher masks these two
  layers to whatever shape the device uses, so the mark lives on the
  foreground with a safe-zone inset and the plate colour is a flat background.
  Devices older than API 26 fall back to the ic_launcher.png in each mipmap.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background"/>
    <foreground android:drawable="@mipmap/ic_launcher_foreground"/>
    <monochrome android:drawable="@mipmap/ic_launcher_foreground"/>
</adaptive-icon>
